# Based on the Arch Linux Firefox PKGBUILD.
pkgname=kanso-browser
pkgver=${KANSO_PKGVER:-160.0.1}
pkgrel=10
pkgdesc='Gecko browser with live Omarchy appearance'
url='https://www.firefox.com/'
arch=(x86_64)
license=(MPL-2.0)
depends=(
  alsa-lib at-spi2-core bash cairo dbus ffmpeg fontconfig freetype2
  gdk-pixbuf2 glib2 glibc gtk3 hicolor-icon-theme libgcc libpulse libstdc++
  libx11 libxcb libxcomposite libxdamage libxext libxfixes libxrandr libxss
  libxt mime-types pango ttf-font
)
makedepends=(
  cbindgen clang diffutils imake jack librsvg lld llvm mesa nasm nodejs python
  rust unzip wasi-compiler-rt wasi-libc wasi-libc++ wasi-libc++abi yasm zip
)
checkdepends=(python nodejs)
optdepends=(
  'hunspell-dictionary: Spell checking'
  'hyprland: Live corner radius synchronization'
  'xdg-desktop-portal: Wayland screen sharing'
  'networkmanager: Network geolocation'
  'speech-dispatcher: Text to speech'
  'tor: Open .onion addresses through the local Tor service'
)
options=(!emptydirs !lto !debug !makeflags strip)

_patches=(
  0000-install-under-remoting-name.patch
  0001-kanso-branding.patch
  0002-omarchy-browser-chrome.patch
  0003-kanso-new-tab.patch
  0004-kanso-onion-routing.patch
  0005-kanso-omarchy-surfaces.patch
)
_mozilla_source="https://archive.mozilla.org/pub/firefox/releases/$pkgver/source/firefox-$pkgver.source.tar.xz"
source=("$_mozilla_source" "$_mozilla_source.asc" kanso-overlay.tar.gz)
validpgpkeys=(14F26682D0916CDD81E37B6D61B7B526D98F0353)
sha256sums=(
  "${KANSO_SOURCE_SHA256:-7b9d95ddf24f7bbf5d0d05698bc02a66dac1eca438f80e093c5c76af7648b06d}"
  SKIP
  8f5d8b7bd06c13fe94a4935c4c4bfefdc715a1a4cda7314f33ade944b0e4f3eb # Kanso overlay
)

prepare() {
  cd "$srcdir/firefox-$pkgver"
  local overlay="$srcdir/kanso-overlay"
  local name
  for name in "${_patches[@]}"; do
    patch --batch --forward -p1 < "$overlay/patches/$name"
  done
  install -d "$srcdir/mozbuild"
  bash "$overlay/packaging/apply-overlay" "$PWD" "$overlay/kanso-components"
  install -m644 "$overlay/packaging/mozconfig" .mozconfig
}

_gecko_env() {
  export MOZBUILD_STATE_PATH="$srcdir/mozbuild"
  export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=none
  export MOZ_NOSPAM=1
  export CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  export CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  export CFLAGS="${CFLAGS/-fexceptions/}"
  export CXXFLAGS="${CXXFLAGS/-fexceptions/}"
}

build() {
  cd "$srcdir/firefox-$pkgver"
  _gecko_env
  ./mach build -j "${KANSO_JOBS:-6}"
}

check() {
  cd "$srcdir/firefox-$pkgver"
  _gecko_env
  node --test "$srcdir/kanso-overlay/tests/palette.test.mjs"
  ./mach package
  /usr/bin/python "$srcdir/kanso-overlay/tests/smoke.py" obj-kanso/dist/kanso-browser/kanso-browser
}

package() {
  cd "$srcdir/firefox-$pkgver"
  _gecko_env
  DESTDIR="$pkgdir" ./mach install
  local appdir="$pkgdir/usr/lib/$pkgname"
  local overlay="$srcdir/kanso-overlay"
  install -Dm644 "$overlay/packaging/vendor.js" "$appdir/browser/defaults/preferences/vendor.js"
  install -Dm644 "$overlay/packaging/kanso-browser.desktop" "$pkgdir/usr/share/applications/kanso-browser.desktop"
  install -Dm644 "$overlay/kanso-components/kanso.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/kanso-browser.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/kanso-browser/LICENSE"
  touch "$appdir/is-packaged-app"
}
