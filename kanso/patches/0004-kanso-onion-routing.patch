+bool nsProtocolProxyService::IsOnionURI(nsIURI* aURI) {
+  nsAutoCString host;
+  if (NS_FAILED(aURI->GetAsciiHost(host))) {
+    return false;
+  }
+  host.Trim(".", false, true);
+  return StringEndsWith(host, ".onion"_ns, nsCaseInsensitiveCStringComparator);
+}
