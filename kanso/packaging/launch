#!/usr/bin/python -I
"""Launch Kanso and apply verified updates from its GitHub releases."""

from contextlib import contextmanager, nullcontext
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import selectors
import socket
import socketserver
import subprocess
import sys
import tempfile
from threading import Event, Lock, Thread
from time import monotonic


REPO = "chilloviAKRI/kanso"
LATEST_RELEASE = f"https://github.com/{REPO}/releases/latest/download/kanso-update.json"
SYSTEM_APP = Path("/usr/lib/kanso-browser")
SYSTEM_COMMAND = Path("/usr/bin/kanso-browser")
SYSTEM_LOCK = Path("/run/lock/kanso-browser.lock")
APP = Path(__file__).resolve().parent
UPDATE_EXIT_STATUS = 83
OFFER_ENV = "KANSO_UPDATE_OFFER"
ONION_PORT_ENV = "KANSO_ONION_PROXY_PORT"
VERSION = re.compile(r"[0-9]+(?:\.[0-9]+){1,2}-[0-9]+(?:\.[0-9]+)?")
MAX_PACKAGE_SIZE = 1024**3
INFORMATION_ONLY = {"--version", "-version", "-v", "--help", "-help", "-h"}
MAINTENANCE = INFORMATION_ONLY | {"--headless", "-headless"}


class OnionProxy(socketserver.ThreadingTCPServer):
    """Wake the browser's Tor client when Gecko connects to its SOCKS endpoint."""

    daemon_threads = True
    request_queue_size = 32

    def __init__(self, tor, state_dir):
        super().__init__(("127.0.0.1", 0), OnionRequest)
        self.tor = tor
        self.state_dir = state_dir
        self.stop = Event()
        self.start_lock = Lock()
        self.process = None
        self.control = None
        self.runtime = None

    def start_tor(self):
        self.state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        if self.runtime is None:
            self.runtime = tempfile.TemporaryDirectory(prefix="kanso-onion-", dir="/tmp")
        runtime = Path(self.runtime.name)
        config = runtime / "torrc"
        config.touch(mode=0o600)
        self.socks = runtime / "socks"
        self.socks.unlink(missing_ok=True)
        control, child = socket.socketpair()
        try:
            args = [
                self.tor, "--defaults-torrc", config, "-f", config,
                "--RunAsDaemon", "0", "--ClientOnly", "1",
                "--SocksPort", f"unix:{self.socks} OnionTrafficOnly",
                "--SafeSocks", "1",
                "--DataDirectory", self.state_dir,
                "--__OwningControllerFD", str(child.fileno()), "--Log", "warn stderr",
            ]
            if self.tor != Path("/usr/bin/tor"):
                data = self.tor.parent.parent / "share"
                for option, name in (("--GeoIPFile", "geoip"), ("--GeoIPv6File", "geoip6")):
                    if (data / name).is_file():
                        args.extend([option, data / name])
            self.process = subprocess.Popen(args, stdin=subprocess.DEVNULL, pass_fds=(child.fileno(),))
        except OSError:
            control.close()
            raise
        finally:
            child.close()
        self.control = control

    def connect_to_tor(self, peer):
        with self.start_lock:
            if self.stop.is_set():
                raise OSError("Tor session is closing")
            if self.process is None or self.process.poll() is not None:
                if self.control:
                    self.control.close()
                self.start_tor()
            deadline = monotonic() + 5
            peer.settimeout(0.25)
            while not self.stop.is_set() and self.process.poll() is None:
                try:
                    peer.connect(str(self.socks))
                    peer.settimeout(None)
                    return
                except (FileNotFoundError, ConnectionRefusedError, TimeoutError):
                    if monotonic() >= deadline:
                        break
                    self.stop.wait(0.05)
        raise OSError("Tor did not open its SOCKS socket")

    def close_tor(self):
        with self.start_lock:
            if self.control:
                self.control.close()
            if self.process:
                try:
                    self.process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    self.process.kill()
                    self.process.wait()
            if self.runtime:
                self.runtime.cleanup()


class OnionRequest(socketserver.BaseRequestHandler):
    def handle(self):
        with socket.socket(socket.AF_UNIX) as tor:
            try:
                self.server.connect_to_tor(tor)
            except OSError as error:
                if not self.server.stop.is_set():
                    print(f"Kanso Tor: {error}", file=sys.stderr)
                return

            with selectors.DefaultSelector() as selector:
                selector.register(self.request, selectors.EVENT_READ, tor)
                selector.register(tor, selectors.EVENT_READ, self.request)
                try:
                    while selector.get_map() and not self.server.stop.is_set():
                        for source, _ in selector.select(0.2):
                            target = source.data
                            if data := source.fileobj.recv(65536):
                                target.sendall(data)
                            else:
                                selector.unregister(source.fd)
                                target.shutdown(socket.SHUT_WR)
                except OSError:
                    pass


@contextmanager
def tor_session(arguments):
    if INFORMATION_ONLY.intersection(arguments):
        yield None
        return
    tor = Path("/usr/bin/tor")
    if not tor.is_file():
        data = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
        tor = data / "kanso-tor/bin/tor"
    if not os.access(tor, os.X_OK):
        yield None
        return

    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    profile = [arg for arg in restart_arguments(arguments) if arg not in {"--no-remote", "-no-remote"}]
    key = hashlib.sha256(os.fsencode("\0".join(profile))).hexdigest()[:16] if profile else "default"
    try:
        server = OnionProxy(tor, state / "kanso-browser/tor" / key)
    except OSError as error:
        print(f"Kanso Tor: {error}", file=sys.stderr)
        yield None
        return
    with server:
        worker = Thread(target=server.serve_forever, kwargs={"poll_interval": 0.1}, daemon=True)
        worker.start()
        try:
            yield server.server_address[1]
        finally:
            server.stop.set()
            server.shutdown()
            server.close_tor()


def run(command, *args, **options):
    return subprocess.run([f"/usr/bin/{command}", *args], check=True, **options)


def curl(url, *args):
    return run("curl", "--disable", "--fail", "--silent", "--show-error", "--location",
               "--proto", "=https", "--proto-redir", "=https", "--connect-timeout", "3",
               *args, url, stdout=subprocess.PIPE, timeout=185).stdout


def version_in(app):
    version = (app / "release-version").read_text().strip()
    if not VERSION.fullmatch(version):
        raise ValueError("Invalid installed package version")
    return version


def browser_executable(app):
    native = app / "kanso-browser-bin"
    return native if native.is_file() else app / "kanso-browser"


def latest_package(installed):
    data = json.loads(curl(LATEST_RELEASE, "--max-time", "4", "--max-filesize", "4096"))
    version = data["version"]
    if not isinstance(version, str) or not VERSION.fullmatch(version):
        raise ValueError("Invalid Kanso release version")
    if run("vercmp", version, installed, capture_output=True, text=True).stdout.strip() != "1":
        return None
    name = f"kanso-browser-{version}-x86_64.pkg.tar.zst"
    url = f"https://github.com/{REPO}/releases/download/v{version}/{name}"
    digest, size = data["sha256"], data["size"]
    if (isinstance(digest, str) and re.fullmatch(r"[0-9a-f]{64}", digest)
            and type(size) is int and 0 < size <= MAX_PACKAGE_SIZE):
        return version, name, url, digest, size
    raise ValueError(f"Release {version} lacks a verifiable Arch package")


def download_package(release, directory):
    version, name, url, digest, size = release
    archive = directory / name
    curl(url, "--max-time", "180", "--max-filesize", str(size), "--output", archive)
    with archive.open("rb") as stream:
        if archive.stat().st_size != size or hashlib.file_digest(stream, "sha256").hexdigest() != digest:
            raise ValueError(f"Invalid download for Kanso {version}")
    info = run("pacman", "-Qp", "--", archive, capture_output=True, text=True).stdout.strip()
    if info != f"kanso-browser {version}":
        raise ValueError(f"Unexpected package metadata for Kanso {version}")
    return archive


def notify(message):
    try:
        run("notify-send", "--app-name=Kanso", "Kanso", message, timeout=2)
    except (OSError, subprocess.SubprocessError):
        pass


def update_user(app, release):
    with tempfile.TemporaryDirectory(prefix=".kanso-update-", dir=app.parent) as temporary:
        directory = Path(temporary)
        archive = download_package(release, directory)
        run("bsdtar", "-xf", archive, "-C", directory, "usr/lib/kanso-browser")
        replacement = directory / "usr/lib/kanso-browser"
        if not os.access(replacement / "launch", os.X_OK) or not (replacement / "browser/omni.ja").is_file():
            raise ValueError("Incomplete Kanso application")
        if version_in(replacement) != release[0]:
            raise ValueError("Application and package versions differ")
        executable = browser_executable(replacement)
        if executable.resolve() == (replacement / "launch").resolve():
            raise ValueError("Kanso package is missing its native executable")
        subprocess.run([executable, "--version"], check=True, timeout=5,
                       stdout=subprocess.DEVNULL)
        if is_running(app):
            return
        run("mv", "-T", "--exchange", "--no-copy", "--", replacement, app)


def is_running(app):
    executable = browser_executable(app)
    return executable.is_file() and subprocess.run(["/usr/bin/fuser", "-s", executable]).returncode == 0


@contextmanager
def launch_lock(app, mode):
    if app == SYSTEM_APP:
        path = SYSTEM_LOCK
        flags = os.O_RDONLY
    else:
        path = app.parent / ".kanso-launch.lock"
        flags = os.O_WRONLY | os.O_CREAT
    fd = os.open(path, flags | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, mode)
        yield
    finally:
        os.close(fd)


def update_system():
    # This entry point is run by pkexec. It accepts no caller-supplied package or URL.
    if APP != SYSTEM_APP or os.geteuid() != 0:
        return 1
    with launch_lock(APP, fcntl.LOCK_EX):
        if is_running(APP):
            return 0
        installed = run("pacman", "-Q", "kanso-browser", capture_output=True, text=True).stdout.split()
        version = version_in(APP)
        if installed != ["kanso-browser", version]:
            raise ValueError("The package database and application versions differ")
        if release := latest_package(version):
            with tempfile.TemporaryDirectory(prefix="kanso-update-", dir="/var/tmp") as temporary:
                archive = download_package(release, Path(temporary))
                if not is_running(APP):
                    run("pacman", "-U", "--needed", "--noconfirm", "--", archive)
    return 0


UPDATE_ERRORS = (OSError, ValueError, KeyError, TypeError, AttributeError, subprocess.SubprocessError)


def check_offer(app):
    try:
        if is_running(app):
            return None
        installed = version_in(app)
        if release := latest_package(installed):
            return {"installed": installed, "available": release[0]}
    except UPDATE_ERRORS as error:
        print(f"Kanso update: {error}", file=sys.stderr)
    return None


def apply_offer(app):
    try:
        if app == SYSTEM_APP:
            if offer := check_offer(app):
                notify(f"Installing Kanso {offer['available']}…")
                authorization = subprocess.run(
                    ["/usr/bin/pkexec", "--disable-internal-agent", app / "launch", "--apply-system-update"]
                )
                if authorization.returncode not in (0, 126, 127):
                    authorization.check_returncode()
        else:
            with launch_lock(app, fcntl.LOCK_EX):
                if not is_running(app) and (release := latest_package(version_in(app))):
                    notify(f"Installing Kanso {release[0]}…")
                    update_user(app, release)
    except UPDATE_ERRORS as error:
        print(f"Kanso update: {error}", file=sys.stderr)


def restart_arguments(arguments):
    # Allow session restore to reopen URLs. Retain explicit profile selection.
    flags = iter(arguments)
    result = []
    for arg in flags:
        if arg == "--":
            break
        if arg in {"-P", "-profile", "--profile"}:
            result.extend([arg, next(flags, "")])
        elif arg.startswith(("--profile=", "-profile=")) or arg in {"--no-remote", "-no-remote"}:
            result.append(arg)
    return result


def launch(app, arguments):
    if app != SYSTEM_APP and SYSTEM_COMMAND.is_file():
        os.execv(SYSTEM_COMMAND, [str(SYSTEM_COMMAND), *arguments])
    command = [str(browser_executable(app)), *arguments]
    locked = app != SYSTEM_APP or SYSTEM_LOCK.exists()
    auto = locked and os.getenv("KANSO_DISABLE_AUTO_UPDATE") != "1" and not MAINTENANCE.intersection(arguments)
    environment = dict(os.environ)
    environment.pop(OFFER_ENV, None)
    environment.pop(ONION_PORT_ENV, None)

    # The privileged updater takes the exclusive system lock after authorization.
    # System launches hold a shared lock until Gecko has exec'd. Local installs
    # serialize both steps using the same lock next to the application directory.
    mode = fcntl.LOCK_SH if app == SYSTEM_APP else fcntl.LOCK_EX
    offer = None
    while True:
        with tor_session(arguments) as port:
            child_env = environment.copy()
            if port:
                child_env[ONION_PORT_ENV] = str(port)
            with launch_lock(app, mode) if locked else nullcontext():
                if auto:
                    offer = check_offer(app)
                    auto = False
                if offer:
                    child_env[OFFER_ENV] = json.dumps(offer)
                browser = subprocess.Popen(command, env=child_env)
            status = browser.wait()
        if status != UPDATE_EXIT_STATUS or not offer:
            return status

        apply_offer(app)
        if version_in(app) == offer["installed"]:
            offer["failed"] = True
        else:
            offer = None
            # Package revisions can change privileged JavaScript without changing
            # the Mozilla version. Rebuild the profile's startup cache once.
            environment["MOZ_PURGE_CACHES"] = "1"
        command = [str(browser_executable(app)), *restart_arguments(arguments)]


if __name__ == "__main__":
    arguments = sys.argv[1:]
    if arguments == ["--apply-system-update"]:
        try:
            sys.exit(update_system())
        except UPDATE_ERRORS as error:
            sys.exit(f"Kanso update: {error}")
    sys.exit(launch(APP, arguments))
