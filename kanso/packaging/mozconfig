# Local x86_64 Arch release. Gecko and RLBox use their standard security settings.
ac_add_options --enable-application=browser
ac_add_options --prefix=/usr
ac_add_options --with-app-basename=Kanso
ac_add_options --with-app-name=kanso-browser
ac_add_options --with-user-appdir=kanso
ac_add_options --with-distribution-id=local.kanso
ac_add_options --enable-release
ac_add_options --enable-hardening
ac_add_options --enable-optimize
ac_add_options --enable-linker=lld
ac_add_options --enable-alsa
ac_add_options --enable-jack
ac_add_options --disable-updater
ac_add_options --disable-install-strip
ac_add_options --disable-bootstrap
ac_add_options --with-wasi-sysroot="${KANSO_WASI_SYSROOT:-/usr/share/wasi-sysroot}"
ac_add_options --enable-update-channel=release
ac_add_options --disable-tests

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-kanso

export MOZILLA_OFFICIAL=1
export MOZ_REQUIRE_SIGNING=1
export MOZ_APP_REMOTINGNAME=kanso-browser
